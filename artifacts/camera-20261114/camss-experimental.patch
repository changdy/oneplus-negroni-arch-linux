+static void csiphy_sm8450_cphy_enable(struct csiphy_device *csiphy,
+				      struct csiphy_lanes_cfg *lanes)
+{
+	unsigned int i;
+	u32 mask = 0;
+
+	for (i = 0; i < lanes->num_data; i++)
+		mask |= BIT(2 * lanes->data[i].pos + 1);
+	writel(mask, csiphy->base + 0x1014);
+	writel(0, csiphy->base + 0x1084);
+	writel(1, csiphy->base + 0x1018);
+	writel(0x7a, csiphy->base + 0x101c);
+	writel(0x0e, csiphy->base + 0x1000);
+	usleep_range(3048, 3100);
+	for (i = 0; i < ARRAY_SIZE(rate_regs_sm8450_cphy); i++) {
+		const struct csiphy_lane_regs *r = &rate_regs_sm8450_cphy[i];
+		writel(r->reg_data, csiphy->base + r->reg_addr);
+	}
+	for (i = 0; i < ARRAY_SIZE(lane_regs_sm8450_cphy); i++) {
+		const struct csiphy_lane_regs *r = &lane_regs_sm8450_cphy[i];
+		u32 val = r->csiphy_param_type == CSIPHY_SETTLE_CNT_LOWER_BYTE ?
+			lanes->settle_count : r->reg_data;
+		writel(val, csiphy->base + r->reg_addr);
+		if (r->delay_us)
+			udelay(r->delay_us);
+	}
+	for (i = 11; i < 22; i++)
+		writel(0, csiphy->base + 0x1000 + 4 * i);
