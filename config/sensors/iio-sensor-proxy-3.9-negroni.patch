+static gboolean
+reannounce_sensors (gpointer user_data)
+{
+	SensorData *data = user_data;
+
+	/* KWin reads HasAccelerometer as soon as the bus name appears, which
+	 * can be before discovery finishes, and a late reply can overwrite the
+	 * later property change. Announce again once the value is stable. */
+	send_dbus_event (data, PROP_ALL);
+	send_dbus_event (data, PROP_ALL_COMPASS);
+	return G_SOURCE_REMOVE;
+}
