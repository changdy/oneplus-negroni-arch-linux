#!/bin/bash
# Publish the TCS3701 description, then restart SLPI so it reads SMEM item 130.
set -euo pipefail
payload=/usr/lib/negroni/smem-sensor.bin
[[ $(stat -c %s "$payload") == 5140 ]] || { echo 'invalid SMEM sensor payload size' >&2; exit 1; }
modprobe smem_sensor
for _ in $(seq 1 30); do
    [[ -e /sys/kernel/debug/smem_sensor ]] && break
    sleep 1
done
if [[ ! -e /sys/kernel/debug/smem_sensor ]]; then
    echo 'smem_sensor debugfs node is missing; debugfs must be mounted' >&2
    exit 1
fi
slpi=
for _ in $(seq 1 30); do
    for rproc in /sys/class/remoteproc/remoteproc*; do
        [[ -e $rproc/firmware ]] || continue
        if [[ $(cat "$rproc/firmware") == slpi.mdt ]]; then
            slpi=$rproc
            break
        fi
    done
    [[ -n $slpi ]] && break
    sleep 1
done
[[ -n $slpi ]] || { echo 'SLPI remoteproc not found' >&2; exit 1; }
dd if="$payload" of=/sys/kernel/debug/smem_sensor bs=5140 count=1 conv=notrunc status=none
cmp "$payload" /sys/kernel/debug/smem_sensor
echo 'TCS3701 SMEM data verified'

start_slpi() {
    case $(cat "$slpi/state") in
        running) echo stop > "$slpi/state" ;;
        offline) ;;
        *) echo 'SLPI is not running or offline' >&2; exit 1 ;;
    esac
    echo start > "$slpi/state"
}

# FastRPC can appear long before SSC publishes sensors. A partially discovered
# device set can persist in both the firmware and the running desktop proxy.
wait_for_imu() {
    local deadline=$((SECONDS + 75)) accel
    while (( SECONDS < deadline )); do
        if [[ -e /dev/fastrpc-sdsp ]] &&
            accel=$(LC_ALL=C timeout -k 1 8 ssccli --sensor=accelerometer --timeout=1 2>/dev/null) &&
            [[ $accel == *'Accelerometer sensor measurement: X='* ]] &&
            timeout -k 1 8 /usr/local/sbin/negroni-gyro --once >/dev/null 2>&1; then
            echo 'SSC delivered accelerometer and gyroscope samples'
            return 0
        fi
        sleep 2
    done
    return 1
}

start_slpi
if wait_for_imu; then exit 0; fi
echo 'SSC did not deliver both IMU samples; restarting SLPI once' >&2
start_slpi
if wait_for_imu; then exit 0; fi
echo 'IMU unavailable after SLPI recovery' >&2
exit 1
