[Unit]
Description=Allow Adreno GPU runtime power saving
Before=display-manager.service
Conflicts=gpu-runtime-active.service

[Service]
Type=oneshot
ExecStart=/usr/bin/sh -c 'printf 1000 > /sys/bus/platform/devices/3d00000.gpu/power/autosuspend_delay_ms'
ExecStart=/usr/bin/sh -c 'printf auto > /sys/bus/platform/devices/3d00000.gpu/power/control'
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
