 /*****************************************************************************/
 
+void
+mm_qrtr_bus_watcher_rescan (MMQrtrBusWatcher *self)
+{
+    GHashTableIter iter;
+    gpointer node_id;
+
+    g_return_if_fail (MM_IS_QRTR_BUS_WATCHER (self));
+    /* Pending nodes will emit their normal added signal when ready. */
+    g_hash_table_iter_init (&iter, self->priv->ready_nodes);
+    while (g_hash_table_iter_next (&iter, &node_id, NULL))
+        g_signal_emit (self, signals[QRTR_DEVICE_ADDED], 0, GPOINTER_TO_UINT (node_id));
+}
+
 QrtrNode *
 mm_qrtr_bus_watcher_peek_node (MMQrtrBusWatcher *self,
                                guint32           node_id)
