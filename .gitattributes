* text=auto
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.path text eol=lf
*.desktop text eol=lf
*.page text eol=lf
config/packages/*.txt text eol=lf
*.bundle binary
*.tar.gz binary
*.img binary

# Unified diff context lines prefix the original tab indentation with a space.
patches/linux/*.patch whitespace=-space-before-tab
*.bin binary
*.m4 text eol=lf
config/audio/*.patch whitespace=-space-before-tab
config/volte/81voltd binary
config/volte/*.patch whitespace=-space-before-tab
# Preserve upstream unified-diff context lines, including blank context at EOF.
config/gnss/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
artifacts/usb2-gadget-20261113/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
/artifacts/camera-20261114/** text eol=lf
artifacts/camera-20261113/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
artifacts/camera-20261114/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
artifacts/camera-20261118/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
artifacts/camera-20261118/PKGBUILD text eol=lf
config/gnss/sources.txt text eol=lf
config/gnss/runtime/ModemManager binary
config/gnss/runtime/*.so.* binary
config/gnss/runtime/SHA256SUMS text eol=lf
artifacts/usb2-gadget-20261113/experiments/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
*.rules text eol=lf
*.source text eol=lf
/config/sensors/negroni-smem-sensor text eol=lf
/config/sensors/negroni-sensor-files text eol=lf
/config/sensors/hexagonrpcd-sdsp-wait text eol=lf
/config/quicksettings/negroni-hardware-control text eol=lf

# Stock sensor JSON is served to the SLPI byte for byte; two files carry CRLF.
/config/sensors/qcom/** -text -whitespace

# Keep the verified stock module archive byte-identical to its SHA256SUMS.
/downloads/stock-drivers-20261113/vendor_dlkm_b/** binary

# License copies participate in the delivered payload checksum.
config/gnss/runtime/COPYING* text eol=lf
