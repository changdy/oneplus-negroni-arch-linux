* text=auto
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.bundle binary
*.tar.gz binary
*.img binary

# Unified diff context lines prefix the original tab indentation with a space.
patches/linux/*.patch whitespace=-space-before-tab
*.bin binary
*.m4 text eol=lf
config/audio/*.patch whitespace=-space-before-tab
config/volte/81voltd binary
config/volte/*.patch whitespace=-space-before-tab
# Preserve upstream unified-diff context lines, including blank context at EOF.
config/gnss/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
artifacts/usb2-gadget-20261113/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
config/gnss/sources.txt text eol=lf
*.rules text eol=lf
*.source text eol=lf
